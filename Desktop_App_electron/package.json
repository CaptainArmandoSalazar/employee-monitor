{
  "name": "employee-monitor-desktop",
  "version": "1.0.0",
  "description": "Employee Monitoring Desktop App",
  "main": "dist/main/main.js",
  "homepage": "https://avdevs.com",
  "author": {
    "name": "AvDevs",
    "email": "admin@avdevs.com"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dev": "concurrently \"tsc --watch\" \"cp src/main/services/inputWorker.js dist/main/services/inputWorker.js && wait-on dist/main/main.js && electron . --dev\"",
    "dist": "npm run build && cp src/main/services/inputWorker.js dist/main/services/inputWorker.js && electron-builder",
    "dist:linux": "npm run build && cp src/main/services/inputWorker.js dist/main/services/inputWorker.js && electron-builder --linux AppImage deb",
    "dist:win": "npm run build && electron-builder --windows nsis",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "rebuild": "electron-rebuild -f -w uiohook-napi"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "node-fetch": "^2.7.0",
    "node-global-key-listener": "^0.3.0",
    "uiohook-napi": "^1.5.4",
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.avdevs.employeemonitor",
    "productName": "Employee Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "src/main/services/inputWorker.js",
        "to": "resources/app/inputWorker.js"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-global-key-listener/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "extendInfo": {
        "NSAccessibilityUsageDescription": "Employee Monitor needs accessibility access to track keystrokes for productivity monitoring."
      },
      "identity": "null",
      "hardenedRuntime": "false",
      "gatekeeperAssess": "false"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "employee-monitor",
      "maintainer": "AvDevs <admin@avdevs.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "deb": {
      "depends": [
        "libxtst6",
        "libx11-6",
        "libfuse2",
        "xdotool",
        "wmctrl"
      ],
      "scripts": {
        "postinst": "build/linux/postinst"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CaptainArmandoSalazar/employee-monitor.git"
  }
}
