{
  "name": "employee-monitor",
  "version": "2.0.0",
  "description": "Employee Monitoring Desktop Application",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json",
    "start": "npm run build && electron .",
    "dev": "concurrently \"tsc -w -p tsconfig.main.json\" \"electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.company.employeemonitor",
    "productName": "Employee Monitor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "resources/**/*"
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "electron-store": "^8.1.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  }
}
